@model BarangayCMS.Web.Areas.Admin.Models.ResidentViewModel

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Register New Resident";
}

<div class="mb-4">
    <a href="/Admin/Residents" class="btn btn-sm btn-outline-secondary mb-3">
        <i class="bi bi-arrow-left"></i> Back to Roster
    </a>
    <h2 class="fw-bold text-dark"><i class="bi bi-person-plus-fill text-primary me-2"></i>Register New Resident</h2>
    <p class="text-muted small">Input complete demographic census data profiles into the database engine block parameters.</p>
</div>

<div class="card border-0 shadow-sm rounded p-4">
    <form action="/Admin/Residents/Create" method="post">
        @Html.AntiForgeryToken()

        <div class="row g-3">
            <div class="col-md-4">
                <label for="FirstName" class="form-label fw-semibold text-dark">First Name</label>
                <input type="text" class="form-control" id="FirstName" name="FirstName" placeholder="e.g., Juan" required />
            </div>
            <div class="col-md-4">
                <label for="MiddleName" class="form-label fw-semibold text-dark">Middle Name</label>
                <input type="text" class="form-control" id="MiddleName" name="MiddleName" placeholder="e.g., Ramos" />
            </div>
            <div class="col-md-4">
                <label for="LastName" class="form-label fw-semibold text-dark">Last Name</label>
                <input type="text" class="form-control" id="LastName" name="LastName" placeholder="e.g., Dela Cruz" required />
            </div>

            <div class="col-md-4">
                <label for="Gender" class="form-label fw-semibold text-dark">Gender Selection</label>
                <select class="form-select" id="Gender" name="Gender" required>
                    <option value="" selected disabled>Select Gender</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                </select>
            </div>
            <div class="col-md-4">
                <label for="BirthDate" class="form-label fw-semibold text-dark">Date of Birth</label>
                <input type="date" class="form-control" id="BirthDate" name="BirthDate" required />
            </div>
            <div class="col-md-4">
                <label for="CivilStatus" class="form-label fw-semibold text-dark">Civil Status</label>
                <select class="form-select" id="CivilStatus" name="CivilStatus" required>
                    <option value="" selected disabled>Select Status</option>
                    <option value="Single">Single</option>
                    <option value="Married">Married</option>
                    <option value="Widowed">Widowed</option>
                    <option value="Divorced">Divorced</option>
                </select>
            </div>

            <div class="col-md-8">
                <label for="Address" class="form-label fw-semibold text-dark">Complete Address (House No, Street, Purok)</label>
                <input type="text" class="form-control" id="Address" name="Address" placeholder="e.g., #14 Ext. St., Purok 3 Silangan" required />
            </div>
            <div class="col-md-4">
                <label for="ContactNumber" class="form-label fw-semibold text-dark">Contact Number</label>
                <input type="text" class="form-control" id="ContactNumber" name="ContactNumber" placeholder="e.g., 09123456789" />
            </div>
        </div>

        <div class="d-flex gap-2 justify-content-end mt-4 pt-3 border-top">
            <a href="/Admin/Residents" class="btn btn-light px-4">Cancel</a>
            <button type="submit" class="btn btn-primary px-4 fw-semibold">
                <i class="bi bi-check-circle-fill me-1"></i> Complete Registration
            </button>
        </div>
    </form>
</div>