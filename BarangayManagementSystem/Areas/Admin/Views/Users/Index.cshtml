@model IEnumerable<BarangayCMS.Web.Areas.Admin.Models.UserViewModel>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "System User Accounts";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-person-gear text-primary me-2"></i>User Accounts
        </h2>
        <p class="text-muted small mb-0">Manage system login credentials, portal access levels, and account roles.</p>
    </div>

    <!-- 🔑 GUMAGANA NA: Pindutan na may tamang asp actions -->
    <a asp-area="Admin" asp-controller="Users" asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-person-plus-fill me-1"></i> Create User Account
    </a>
</div>

<div class="card border-0 shadow-sm rounded p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Username</th>
                    <th>Email Address</th>
                    <th>Full Name</th>
                    <th>Role Group</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@user.Username</td>
                            <td>@user.Email</td>
                            <td>@user.FullName</td>
                            <td>
                                <span class="badge @(user.Role == "SuperAdmin" ? "bg-dark" : "bg-primary")">
                                    @user.Role
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <!-- Mock items kung wala pang laman ang iyong DB table -->
                    <tr>
                        <td class="fw-semibold">admin_root</td>
                        <td>admin_root@barangay.gov.ph</td>
                        <td>System Administrator</td>
                        <td><span class="badge bg-dark">SuperAdmin</span></td>
                    </tr>
                    <tr>
                        <td class="fw-semibold">clerk.maria</td>
                        <td>clerk.maria@barangay.gov.ph</td>
                        <td>Maria Santos</td>
                        <td><span class="badge bg-primary">Staff / Encoder</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>