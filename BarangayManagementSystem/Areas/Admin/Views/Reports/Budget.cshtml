@model IEnumerable<BarangayCMS.Web.Areas.Admin.Models.ProjectBudgetReportItem>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Financial Budget Report";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4><i class="bi bi-cash-coin text-success"></i> Ulat sa Pananalapi at Pondo ng Barangay</h4>
        <!-- 🔑 NAAYOS: Idinagdag ang asp-area at asp-controller para sigurado ang balik sa Reports main engine -->
        <a asp-area="Admin" asp-controller="Reports" asp-action="Index" class="btn btn-sm btn-outline-secondary">Bumalik</a>
    </div>

    <div class="card shadow-sm">
        <table class="table table-bordered mb-0">
            <thead class="table-success">
                <tr>
                    <th>Pangalan ng Alokasyon / Proyekto</th>
                    <th>Inilaang Pondo</th>
                    <th>Nagastos na Halaga</th>
                    <th>Natitira (SOP)</th>
                    <th>Pinagmulan ng Pondo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var balance = item.AllocatedBudget - item.ExpensesToDate;
                    <tr>
                        <td><strong>@item.ProjectName</strong></td>
                        <td>₱@item.AllocatedBudget.ToString("N2")</td>
                        <td class="text-danger">₱@item.ExpensesToDate.ToString("N2")</td>
                        <td class="fw-bold text-success">₱@balance.ToString("N2")</td>
                        <td><span class="badge bg-light text-dark border">@item.FundingSource</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>