@model IEnumerable<BarangayCMS.Web.Areas.Admin.Models.ProjectBudgetReportItem>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Infrastructure & Development Projects";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4><i class="bi bi-hammer text-warning"></i> Monitoring ng mga Proyekto ng Barangay</h4>
        <!-- 🔑 NAAYOS: Nilagyan ng selyadong Admin routing path -->
        <a asp-area="Admin" asp-controller="Reports" asp-action="Index" class="btn btn-sm btn-outline-secondary">Bumalik</a>
    </div>

    <div class="row">
        @foreach (var project in Model)
        {
            <div class="col-md-6 mb-3">
                <div class="card shadow-sm h-100 border-start border-warning border-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <h5 class="fw-bold">@project.ProjectName</h5>
                            <span class="badge bg-info text-dark">@project.Status</span>
                        </div>
                        <p class="text-muted small mb-2">Fund: @project.FundingSource</p>
                        <div class="progress mb-2" style="height: 8px;">
                            <div class="progress-bar bg-warning" role="progressbar" style="width: 75%"></div>
                        </div>
                        <small class="text-secondary">Pondo: ₱@project.AllocatedBudget.ToString("N2")</small>
                    </div>
                </div>
            </div>
        }
    </div>
</div>